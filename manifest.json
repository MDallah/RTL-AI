{
  "manifest_version": 3,
  "name": "RTL AI",
  "version": "1.0.0",
  "description": "Automatically detects and fixes RTL (right-to-left) text in AI responses from ChatGPT, Gemini, Claude, and more",
  "browser_specific_settings": {
    "gecko": {
      "id": "rtl-ai@addon",
      "strict_min_version": "128.0"
    }
  },
  "minimum_chrome_version": "121",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://qwen.ai/*",
        "https://chat.qwen.ai/*",
        "https://www.kimi.ai/*",
        "https://www.kimi.com/*",
        "https://aistudio.google.com/*",
        "https://deepseek.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "RTL AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
